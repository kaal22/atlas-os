#!/bin/sh
set -e
# Prepare /srv/atlas skeleton + OS identity for the image.
# Do NOT create firstboot-pending here — that must only appear on the
# installed target (Calamares), never in the live session.
mkdir -p /etc/atlas
# Explicit dirs — this hook runs under /bin/sh (dash), which does NOT expand braces.
# A quoted/brace mkdir would create a literal "{users,workspaces,...}" directory.
mkdir -p \
  /srv/atlas/users \
  /srv/atlas/workspaces \
  /srv/atlas/documents \
  /srv/atlas/knowledge \
  /srv/atlas/embeddings \
  /srv/atlas/models \
  /srv/atlas/maps \
  /srv/atlas/kiwix \
  /srv/atlas/kolibri \
  /srv/atlas/media \
  /srv/atlas/content-packs \
  /srv/atlas/agent-packages \
  /srv/atlas/backups \
  /srv/atlas/exports \
  /srv/atlas/databases \
  /srv/atlas/logs \
  /srv/atlas/tmp
chmod 755 /srv/atlas
rm -f /etc/atlas/firstboot-pending /etc/atlas/firstboot-done

# Public OS identity (Plymouth/login/grub tooling read /etc/os-release).
cat > /etc/os-release <<'EOF'
PRETTY_NAME="Arcalium OS 0.1.0-alpha"
NAME="Arcalium OS"
VERSION_ID="0.1"
VERSION="0.1.0-alpha"
VERSION_CODENAME=alpha
ID=arcalium
ID_LIKE=debian
HOME_URL="https://arcalium.local/"
SUPPORT_URL="https://arcalium.local/support"
BUG_REPORT_URL="https://arcalium.local/issues"
EOF
cp -f /etc/os-release /etc/atlas/os-release

mkdir -p /etc/default/grub.d
cat > /etc/default/grub.d/atlas.cfg <<'EOF'
GRUB_DISTRIBUTOR="Arcalium"
GRUB_CMDLINE_LINUX_DEFAULT="quiet splash"
EOF
